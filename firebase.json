{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "serviceAccountKey.json",
      "DEPLOY.bat",
      "bingo-server.js",
      "firebase-debug.log",
      "android/**",
      ".playwright-mcp/**",
      "git",
      "**/*.md",
      "restore-draw-schedules.js",
      "draw-schedules.json",
      "status.json",
      "serviceAccountKey.json"
    ],
    "redirects": [
      { "source": "/news.html", "destination": "/", "type": 301 },
      { "source": "/news-admin.html", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/downloads/*.apk",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"RBLive.apk\"" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".eslintrc.js"
      ]
    }
  ]
}
